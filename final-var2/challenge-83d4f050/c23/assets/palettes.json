{
  "$note": "Canonical palette & glyph semantics for the pathway skill. model.py merges this file over its built-in defaults (single source of truth for colors/widths; edit here and re-run). Aligned with references/legend-encoding.md.",
  "node_types": {
    "protein":        {"shape": "roundrect", "fill": "#EAF2FB", "stroke": "#1F4E79", "zh": "蛋白质", "en": "protein"},
    "gene":           {"shape": "rect", "fill": "#FFF3E0", "stroke": "#B9770E", "italic": true, "zh": "基因", "en": "gene"},
    "complex":        {"shape": "roundrect", "fill": "#EDE7F6", "stroke": "#6C3483", "double": true, "zh": "复合物", "en": "complex"},
    "rna":            {"shape": "roundrect", "fill": "#E8F8F5", "stroke": "#117A65", "dash": true, "zh": "RNA", "en": "RNA"},
    "small_molecule": {"shape": "circle", "fill": "#FDEBD0", "stroke": "#CA6F1E", "zh": "小分子/配体/代谢物", "en": "small molecule / ligand"},
    "other":          {"shape": "roundrect", "fill": "#F4F6F6", "stroke": "#7F8C8D", "zh": "其他", "en": "other"}
  },
  "edge_types": {
    "activation":   {"marker": "arrow",   "color": "#2E7D32", "width": 2.4, "zh": "激活 / 促进", "en": "activation / promotion"},
    "inhibition":   {"marker": "bar",     "color": "#C0392B", "width": 2.4, "zh": "抑制 / 阻断", "en": "inhibition / block"},
    "binding":      {"marker": "none",    "color": "#1F4E79", "width": 2.0, "zh": "结合 / 互作 / 募集", "en": "binding / interaction / recruitment"},
    "modification": {"marker": "circle",  "color": "#B9770E", "width": 2.0, "zh": "修饰（磷酸化、泛素化等）", "en": "modification (phosphorylation, ubiquitination, ...)"},
    "transport":    {"marker": "diamond", "color": "#6C3483", "width": 2.2, "zh": "转运 / 转位", "en": "transport / translocation"}
  },
  "evidence_width": {"strong": 2.8, "moderate": 2.2, "weak": 1.6},
  "compartments": {
    "extracellular": {"zh": "胞外", "en": "Extracellular", "rank": 0, "fill": "#FBFCFC", "stroke": "#D5DBDB", "height": 150},
    "membrane":      {"zh": "细胞膜", "en": "Plasma membrane", "rank": 1, "fill": "#EBF5FB", "stroke": "#5DADE2", "height": 90},
    "cytoplasm":     {"zh": "细胞质", "en": "Cytoplasm", "rank": 2, "fill": "#FDFEFE", "stroke": "#D5DBDB", "height": 170},
    "nucleus":       {"zh": "细胞核", "en": "Nucleus", "rank": 3, "fill": "#F4ECF7", "stroke": "#AF7AC5", "height": 170}
  },
  "data_mapping": {
    "field": "表达量",
    "label_zh": "实体填充色 = 相对表达量（数据映射）",
    "label_en": "node fill = relative expression",
    "low": "#FFF7E0",
    "high": "#1F4E79",
    "note_zh": "材料未给出数值时使用类型默认色（见实体样式区）",
    "note_en": "type default color is used when no data value is available"
  }
}