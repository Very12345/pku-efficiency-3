{
  "schema_version": "1.0",
  "case_id": "example-micelle-001",
  "title": "pH 响应型聚合物胶束用于肿瘤药物递送",
  "task": "纳米载体能否在血液循环中稳定、并在肿瘤微环境中响应性释放化疗药物，是肿瘤靶向递送的核心挑战。",
  "panels": {
    "question": [
      "生理 pH（7.4）下胶束应保持稳定、避免提前泄漏。",
      "肿瘤微环境 pH 约 5.5-6.5，希望触发快速释放。"
    ],
    "method": [
      "合成 mPEG-PLA 嵌段共聚物，自组装包载 DOX（阿霉素）。",
      "DLS 测定粒径与 PDI；紫外分光光度法测定载药量与包封率。",
      "透析法考察 pH 5.5 与 pH 7.4 下的累积释放曲线。"
    ],
    "results": [
      "粒径 95 nm，PDI 0.12，分布均一。",
      "载药量 14.2 %，包封率 72 %。",
      "h 累积释放：pH 5.5 为 85 %，pH 7.4 仅 18 %，呈现明显 pH 响应。",
      "µg/mL 时肿瘤细胞存活率 18 %。"
    ],
    "conclusion": [
      "单页图形摘要，按“问题→方法→结果→结论”顺序排布。",
      "交付可编辑 SVG 源文件与渲染预览（PNG/PDF）。",
      "图中每个实体、数值标注来源；缺失数值不得编造。"
    ]
  },
