{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "figure_map.schema.json",
  "title": "figure_map.schema — 科研图规格（figure spec）声明式契约",
  "description": "每个案例的 figures[] 项必须符合本 schema 的形状。spec_lint.py 按本文件声明的词表手工校验（不依赖 jsonschema 库）。列名/分类/实体 id 必须在源材料中存在（lint 用 --case 提供的实际数据上下文核对）。",
  "type": "object",
  "required": ["id", "type"],
  "properties": {
    "id": {"type": "string", "description": "图 id（result/产物文件名 figure-<id>.svg）"},
    "type": {"enum": ["bar", "line", "scatter", "box", "heatmap", "pie", "network", "panel", "auto"],
             "description": "图型；auto=按数据形状推断"},
    "title": {"type": "string"},
    "subtitle": {"type": "string"},
    "width": {"type": "integer", "minimum": 200, "maximum": 5000, "default": 1200},
    "height": {"type": "integer", "minimum": 200, "maximum": 5000, "default": 800},
    "style": {"enum": ["default", "nature", "cell", "prism", "minimal", "ppt"]},
    "filter": {"type": "object",
               "properties": {"column": {"type": "string"}, "eq": {}},
               "required": ["column", "eq"],
               "description": "构建前按列过滤行，如 {\"column\":\"time_h\",\"eq\":\"24\"}"},
    "layout": {"type": "object",
               "properties": {"margin_left": {"type": "integer"}, "margin_right": {"type": "integer"},
                              "margin_top": {"type": "integer"}, "margin_bottom": {"type": "integer"}}},
    "x": {"type": "object",
          "properties": {"column": {"type": "string"}, "label": {"type": "string"},
                         "unit": {"type": "string"}, "tick_rotation": {"type": "integer"}},
          "required": ["column"]},
    "y": {"type": "object",
          "properties": {"column": {"type": "string"}, "label": {"type": "string"},
                         "unit": {"type": "string"}, "error_column": {"type": "string"}},
          "required": ["column"]},
    "hue": {"type": "object",
            "properties": {"column": {"type": "string"}, "labels": {"type": "object"}},
            "required": ["column"]},
    "error": {"type": "object",
              "properties": {"column": {"type": "string"},
                             "semantics": {"enum": ["SE", "SEM", "SD", "STD", "CI", "95% CI", "semantics"]}},
              "required": ["column", "semantics"],
              "description": "误差线语义必须来自源元数据（D8）"},
    "series": {"type": "array", "items": {"type": "object",
               "properties": {"column": {"type": "string"}, "label": {"type": "string"},
                              "error": {"type": "string"}}, "required": ["column"]}},
    "annotations": {"type": "array", "items": {"type": "object",
                    "properties": {"from": {}, "to": {}, "at": {}, "text": {"type": "string"},
                                   "p": {"type": "number"}, "source": {"type": "string"}},
                    "description": "显著性标注：from/to（两组间线段）或 at（单组）；p 值只转述源材料（D6）"}},
    "colors": {"type": "object", "description": "组/分类 → 颜色的显式映射"},
    "order": {"type": "array", "items": {"type": "string"}, "description": "分类轴显式顺序（不排序，保持科研语义）"},
    "presets": {"type": "array", "description": "box 图直供统计值（min/q1/median/q3/max/n），不代算"},
    "matrix": {"description": "heatmap：二维数组或 {rows:[...], columns:[...]}"},
    "row_labels": {}, "col_labels": {},
    "vmin": {"type": "number"}, "vmax": {"type": "number"},
    "colormap": {"enum": ["bwr", "viridis", "blues", "magma"], "default": "bwr"},
    "labels": {"type": "object", "properties": {"column": {"type": "string"}}},
    "values": {"type": "object", "properties": {"column": {"type": "string"}}},
    "entities": {"type": "array", "description": "network 节点：{id,label,group,shape,cite,x?,y?}"},
    "relations": {"type": "array", "description": "network 关系：{from,to,label,type}"},
    "entities_file": {"type": "string", "description": "nodes/relations JSON 文件（相对 case 目录）"},
    "material_file": {"type": "string", "description": "生物源材料文本（ENTITY:/REL: 行语法或词表扫描）"},
    "layout_mode": {"enum": ["auto", "layer"]},
    "panels": {"type": "array", "description": "panel 子规格（可各带 data_file/filter，递归本 schema）"},
    "grid": {"type": "array", "items": {"type": "integer"}, "maxItems": 2}
  },
  "anyOf": [
    {"properties": {"type": {"enum": ["network"]}}, "required": ["entities"]},
    {"properties": {"type": {"enum": ["panel"]}}, "required": ["panels"]},
    {"properties": {"type": {"enum": ["auto", "bar", "line", "scatter", "box"]}}},
    {"properties": {"type": {"enum": ["heatmap"]}}, "required": ["matrix"]},
    {"properties": {"type": {"enum": ["pie"]}}}
  ]
}